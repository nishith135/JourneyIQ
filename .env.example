DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5439/journeyiq
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5439/journeyiq_test
SANDBOX_DATABASE_URL=postgresql+psycopg://postgres:<PG17_PASSWORD_URL_ENCODED>@127.0.0.1:5432/journeyiq_sandbox
# Explicit runtime target for backend API/UI startup: "primary" (DATABASE_URL) or "sandbox" (SANDBOX_DATABASE_URL)
RUNTIME_DB_TARGET=sandbox
JOURNEYIQ_READER_PASSWORD=<CHOOSE_READONLY_PASSWORD>
APP_ENV=development
DEFAULT_RANDOM_SEED=42
DEFAULT_AS_OF_TIMESTAMP=2026-11-10T00:00:00Z
